# The address of the announcements page. Nothing links to it; knowing it is
# the only thing that gets you there, so treat it the way you would a shared
# password: hand it to whoever needs it, change it when it spreads too far.
#
# Set this at build time (CI environment or .env.local) rather than editing
# the default in src/lib/routes.ts, so the address you actually use is not in
# the repository.
#
# Generate one:
#   node -e "const c=require('crypto'),a='abcdefghjkmnpqrstuvwxyz23456789',p=n=>Array.from(c.randomBytes(n)).map(b=>a[b%a.length]).join('');console.log('/'+p(4)+'-'+p(4)+'-'+p(4))"
VITE_NOTICES_PATH=/8q4f-2pda-vrsa
