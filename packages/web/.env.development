# Cloudflare's published testing sitekey. It renders the real widget, passes
# without interaction and works on any hostname — which is what local
# development needs, because this project's own widget is registered for the
# deployed hostname only. Its matching always-passes secret is in
# packages/api/src/serve.ts. Neither value is a credential; both are in
# Cloudflare's documentation.
VITE_TURNSTILE_SITEKEY=1x00000000000000000000AA
