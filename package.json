{
  "name": "sahlykanta",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Peleille — floorball session registration, replacing a Lotus Domino application",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/infra/tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write .",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.4",
    "vite": "^6.0.5",
    "@playwright/test": "^1.49.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
